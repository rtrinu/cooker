    "/api/ingredients/suggestions": {
      "get": {
        "operationId": "recipes_routers_ingredients_suggest_ingredients",
        "summary": "Suggest Ingredients",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "default": "",
              "title": "Q",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 12,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IngredientOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Autocomplete limited to ingredients some recipe actually uses.\n\nThe USDA import adds thousands of foods nobody can cook with on their own\n(babyfood, restaurant items); sending those to the pantry input would make\nthe suggestion list useless.",
        "tags": [
          "ingredients"
        ]
      }
    },
